<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/primaryDialogButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/dialogImageView"
                android:layout_width="match_parent"
                android:layout_height="223dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cloud_backup"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cloud_backup_dialog" />

            <TextView
                style="@style/Tag.Positive"
                android:layout_width="wrap_content"
                android:paddingHorizontal="@dimen/spacing_xlarge"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/backup_tutorial_tag" />

            <TextView
                style="@style/TextAppearance.Body.Large.Sans.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:paddingHorizontal="@dimen/spacing_xlarge"
                android:gravity="center"
                android:text="@string/backup_tutorial_title" />

            <TextView
                style="@style/TextAppearance.Body.Sans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_xlarge"
                android:text="@string/backup_tutorial_description"
                android:textColor="@color/text_gray" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="@dimen/spacing_xlarge" />

            <include
                android:id="@+id/featureSecureEncryption"
                layout="@layout/item_backup_tutorial_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/featureMultiDeviceSync"
                layout="@layout/item_backup_tutorial_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal" />

            <include
                android:id="@+id/featureAccountRecovery"
                layout="@layout/item_backup_tutorial_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xlarge"/>
        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/primaryDialogButton"
        style="@style/Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_xxlarge"
        android:layout_marginBottom="@dimen/spacing_xxlarge"
        android:text="@string/continue_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Continue" />

</androidx.constraintlayout.widget.ConstraintLayout>
