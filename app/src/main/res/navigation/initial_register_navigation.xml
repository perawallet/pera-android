<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/initialRegisterIntroNavigation"
    app:startDestination="@id/initialRegisterIntroFragment">

    <include app:graph="@navigation/recovery_type_selection_navigation" />

    <include app:graph="@navigation/create_wallet_name_registration_navigation" />

    <fragment
        android:id="@+id/initialRegisterIntroFragment"
        android:name="com.algorand.android.ui.register.initialregisterintro.InitialRegisterIntroFragment"
        android:label="InitialRegisterIntroFragment">
        <action
            android:id="@+id/action_initialRegisterIntroFragment_to_recoveryTypeSelectionNavigation"
            app:destination="@id/recoveryTypeSelectionNavigation" />
        <action
            android:id="@+id/action_initialRegisterIntroFragment_to_createWalletNameRegistrationNavigation"
            app:destination="@id/createWalletNameRegistrationNavigation">
            <argument
                android:name="accountCreation"
                app:argType="com.algorand.android.models.AccountCreation"
                app:nullable="true" />
        </action>
    </fragment>


</navigation>
