<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginNavigation"
    app:startDestination="@id/registerIntroFragment">

    <include app:graph="@navigation/register_watch_account_navigation" />

    <include app:graph="@navigation/create_wallet_name_registration_navigation" />

    <include app:graph="@navigation/backup_passphrase_info_navigation" />

    <include app:graph="@navigation/recovery_type_selection_navigation" />

    <include app:graph="@navigation/asb_import_navigation" />

    <include app:graph="@navigation/recover_with_passphrase_navigation" />

    <include app:graph="@navigation/create_account_name_registration_navigation" />

    <action
        android:id="@+id/action_global_to_homeNavigation"
        app:destination="@id/homeNavigation"
        app:popUpTo="@id/mainNavigation"
        app:popUpToInclusive="true">
        <argument
            android:name="showConfetti"
            android:defaultValue="false"
            app:argType="boolean" />
    </action>

    <action
        android:id="@+id/action_to_lockPreferenceNavigation"
        app:destination="@id/lockPreferenceNavigation"
        app:popUpTo="@id/loginNavigation"
        app:popUpToInclusive="true">
        <argument
            android:name="shouldNavigateHome"
            android:defaultValue="false"
            app:argType="boolean" />
    </action>

    <fragment
        android:id="@+id/registerIntroFragment"
        android:name="com.algorand.android.modules.addaccount.intro.view.AddAccountIntroFragment"
        android:label="AddAccountIntroFragment">
        <argument
            android:name="isShowingCloseButton"
            app:argType="boolean" />
        <action
            android:id="@+id/action_registerIntroFragment_to_recoveryTypeSelectionNavigation"
            app:destination="@id/recoveryTypeSelectionNavigation" />
        <action
            android:id="@+id/action_registerIntroFragment_to_watchAccountInfoFragment"
            app:destination="@id/watchAccountInfoFragment" />
        <action
            android:id="@+id/action_registerIntroFragment_to_registerWatchAccountFragment"
            app:destination="@id/registerWatchAccountFragment"
            app:popUpTo="@id/registerIntroFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerIntroFragment_to_asbImportNavigation"
            app:destination="@id/asbImportNavigation" />
        <action
            android:id="@+id/action_registerIntroFragment_to_hdWalletSelectionFragment"
            app:destination="@id/hdWalletSelectionFragment" />
        <action
            android:id="@+id/action_registerIntroFragment_to_createWalletNameRegistrationNavigation"
            app:destination="@id/createWalletNameRegistrationNavigation">
            <argument
                android:name="accountCreation"
                app:argType="com.algorand.android.models.AccountCreation"
                app:nullable="true" />
        </action>
        <action
            android:id="@+id/action_registerIntroFragment_to_createAccountNameRegistrationNavigation"
            app:destination="@id/createAccountNameRegistrationNavigation">
            <argument
                android:name="accountCreation"
                app:argType="com.algorand.android.models.AccountCreation"
                app:nullable="true" />
        </action>
        <action
            android:id="@+id/action_registerIntroFragment_to_createJointAccountFragment"
            app:destination="@id/createJointAccountFragment" />
    </fragment>

    <fragment
        android:id="@+id/createJointAccountFragment"
        android:name="com.algorand.android.modules.addaccount.joint.creation.ui.createaccount.CreateJointAccountFragment"
        android:label="CreateJointAccountFragment">
        <action
            android:id="@+id/action_createJointAccountFragment_to_addJointAccountFragment"
            app:destination="@id/addJointAccountFragment" />
        <action
            android:id="@+id/action_createJointAccountFragment_to_editAccountNameFragment"
            app:destination="@id/editAccountNameFragment" />
        <action
            android:id="@+id/action_createJointAccountFragment_to_setThresholdFragment"
            app:destination="@id/setThresholdFragment" />
    </fragment>

    <fragment
        android:id="@+id/addJointAccountFragment"
        android:name="com.algorand.android.modules.addaccount.joint.creation.ui.addaccount.AddJointAccountFragment"
        android:label="AddJointAccountFragment" />

    <fragment
        android:id="@+id/editAccountNameFragment"
        android:name="com.algorand.android.modules.addaccount.joint.creation.ui.editname.EditAccountNameFragment"
        android:label="EditAccountNameFragment">
        <argument
            android:name="accountAddress"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/setThresholdFragment"
        android:name="com.algorand.android.modules.addaccount.joint.creation.ui.setthreshold.SetThresholdFragment"
        android:label="SetThresholdFragment">
        <argument
            android:name="participantAddresses"
            app:argType="string[]" />
        <action
            android:id="@+id/action_setThresholdFragment_to_nameJointAccountFragment"
            app:destination="@id/nameJointAccountFragment">
            <argument
                android:name="threshold"
                app:argType="integer" />
            <argument
                android:name="participantAddresses"
                app:argType="string[]" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/nameJointAccountFragment"
        android:name="com.algorand.android.modules.addaccount.joint.creation.ui.namejointaccount.NameJointAccountFragment"
        android:label="NameJointAccountFragment">
        <argument
            android:name="threshold"
            app:argType="integer" />
        <argument
            android:name="participantAddresses"
            app:argType="string[]"
            app:nullable="true" />
        <action
            android:id="@+id/action_nameJointAccountFragment_to_homeNavigation"
            app:destination="@id/homeNavigation"
            app:popUpTo="@id/loginNavigation"
            app:popUpToInclusive="true">
            <argument
                android:name="showConfetti"
                android:defaultValue="true"
                app:argType="boolean" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/hdWalletSelectionFragment"
        android:name="com.algorand.android.ui.register.selectwallet.HdWalletSelectionFragment"
        android:label="HdWalletSelectionFragment">
        <action
            android:id="@+id/action_hdWalletSelectionFragment_to_createAccountNameRegistrationNavigation"
            app:destination="@id/createAccountNameRegistrationNavigation">
            <argument
                android:name="accountCreation"
                app:argType="com.algorand.android.models.AccountCreation"
                app:nullable="true" />
        </action>
        <action
            android:id="@+id/action_hdWalletSelectionFragment_to_createWalletNameRegistrationNavigation"
            app:destination="@id/createWalletNameRegistrationNavigation">
            <argument
                android:name="accountCreation"
                app:argType="com.algorand.android.models.AccountCreation"
                app:nullable="true" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/watchAccountInfoFragment"
        android:name="com.algorand.android.ui.register.watch.WatchAccountInfoFragment"
        android:label="WatchAccountInfoFragment">
        <action
            android:id="@+id/action_watchAccountInfoFragment_to_registerWatchAccountNavigation"
            app:destination="@id/registerWatchAccountNavigation">
            <argument
                android:name="accountAddress"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
        </action>
    </fragment>

</navigation>
