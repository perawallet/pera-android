<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swapV2Navigation"
    app:startDestination="@id/swapFragment">

    <fragment
        android:id="@+id/swapFragment"
        android:name="com.algorand.android.ui.swap.view.SwapFragment"
        android:label="SwapFragment">
        <argument
            android:name="address"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="assetInId"
            android:defaultValue="-1L"
            app:argType="long" />
        <argument
            android:name="assetOutId"
            android:defaultValue="-1L"
            app:argType="long" />

        <action
            android:id="@+id/action_swapFragment_to_swapAssetInSelectionFragment"
            app:destination="@id/swapAssetInSelectionFragment" />
        <action
            android:id="@+id/action_swapFragment_to_swapAssetOutSelectionFragment"
            app:destination="@id/swapAssetOutSelectionFragment" />
        <action
            android:id="@+id/action_swapFragment_to_swapAddressSelectionFragment"
            app:destination="@id/swapAddressSelectionFragment" />
        <action
            android:id="@+id/action_swapFragment_to_swapConfirmationFragment"
            app:destination="@id/swapConfirmationFragment" />
        <action
            android:id="@+id/action_swapFragment_to_swapHistoryFragment"
            app:destination="@id/swapHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/swapAssetInSelectionFragment"
        android:name="com.algorand.android.ui.swap.assetselection.view.SwapAssetInSelectionFragment"
        android:label="SwapAssetInSelectionFragment">

        <argument
            android:name="address"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/swapAssetOutSelectionFragment"
        android:name="com.algorand.android.ui.swap.assetselection.view.SwapAssetOutSelectionFragment"
        android:label="SwapAssetOutSelectionFragment">
        <argument
            android:name="address"
            app:argType="string" />
        <argument
            android:name="assetId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/swapAddressSelectionFragment"
        android:name="com.algorand.android.ui.swap.accountselection.view.SwapAddressSelectionFragment"
        android:label="SwapAddressSelectionFragment" />

    <fragment
        android:id="@+id/swapConfirmationFragment"
        android:name="com.algorand.android.ui.swap.confirmation.view.SwapConfirmationFragment"
        android:label="SwapConfirmationFragment">

        <argument
            android:name="swapQuote"
            app:argType="com.algorand.wallet.swap.domain.model.SwapQuoteV2" />

        <action
            android:id="@+id/action_swapConfirmationFragment_to_swapPriceImpactInfoBottomSheet"
            app:destination="@id/swapPriceImpactInfoBottomSheet" />
        <action
            android:id="@+id/action_swapConfirmationFragment_to_swapSlippageToleranceInfoBottomSheet"
            app:destination="@id/swapSlippageToleranceInfoBottomSheet" />
        <action
            android:id="@+id/action_swapConfirmationFragment_to_swapExchangeFeeInfoBottomSheet"
            app:destination="@id/swapExchangeFeeInfoBottomSheet" />
        <action
            android:id="@+id/action_swapConfirmationFragment_to_swapFragment"
            app:destination="@id/swapFragment"
            app:popUpTo="@id/swapFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/swapHistoryFragment"
        android:name="com.algorand.android.ui.swap.history.view.SwapHistoryFragment"
        android:label="SwapHistoryFragment">

        <argument
            android:name="address"
            app:argType="string" />
    </fragment>

    <dialog
        android:id="@+id/swapPriceImpactInfoBottomSheet"
        android:name="com.algorand.android.modules.swap.priceimpact.ui.PriceImpactInfoBottomSheet"
        android:label="PriceImpactInfoBottomSheet"
        tools:layout="@layout/bottom_sheet_base_information" />

    <dialog
        android:id="@+id/swapSlippageToleranceInfoBottomSheet"
        android:name="com.algorand.android.modules.swap.slippagetolerance.ui.SlippageToleranceInfoBottomSheet"
        android:label="SlippageToleranceInfoBottomSheet"
        tools:layout="@layout/bottom_sheet_base_information" />

    <dialog
        android:id="@+id/swapExchangeFeeInfoBottomSheet"
        android:name="com.algorand.android.modules.swap.confirmswap.ui.ExchangeFeeInfoBottomSheet"
        android:label="ExchangeFeeInfoBottomSheet"
        tools:layout="@layout/bottom_sheet_base_information" />

</navigation>
